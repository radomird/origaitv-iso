#!/bin/bash

# origaitv:summary=Put an ISO where people download it, under its version's name
# origaitv:args=names <channel> <iso.sha256> <dir> | upload <channel> <iso> <dir> | stale <channel> | clean <channel>

# OrigaiTV's ISOs live in a Cloudflare R2 bucket, since an ISO is over GitHub's
# 2 GiB cap for release files. The bucket's iso/ folder holds one ISO for
# each channel: the latest stable release, last night's edge build, and the
# latest release candidate. Each ISO goes by its version, so the file you
# download says what it is:
#
#   iso/origaitv-<version>-x86_64.iso             the ISO
#   iso/origaitv-<version>-x86_64.iso.sha256      its checksum, which names that file
#   iso/origaitv-<version>-x86_64.iso.sha256.sig  the checksum, signed with OrigaiTV's key
#   iso/<channel>.json                          which ISO the channel is on now
#
# A version says which channel it belongs to:
#
#   stable  1.0.0
#   rc      1.0.0-rc1
#   edge    0.2.0.r422.g155320d30, the version of the origaitv package on it,
#           which is what "origaitv version" prints on a box installed from
#           it. A build that's only named by its day and commit keeps that
#           name: edge-2026.11.10-abc1234.
#
# <channel>.json is the link that doesn't change. It's written last: only
# once the ISO, its checksum and its signature are in the bucket and
# checked. If anything before that fails, it still points at the ISO
# before. It looks like this, so a page that offers the download doesn't
# have to guess any of it:
#
#   {
#     "channel": "rc",
#     "version": "1.0.0-rc3",
#     "file": "origaitv-1.0.0-rc3-x86_64.iso",
#     "size": 6712346624,
#     "sha256": "<64 hex digits>",
#     "url": "<ISO_URL>/iso/origaitv-1.0.0-rc3-x86_64.iso",
#     "sha256Url": "<ISO_URL>/iso/origaitv-1.0.0-rc3-x86_64.iso.sha256",
#     "sigUrl": "<ISO_URL>/iso/origaitv-1.0.0-rc3-x86_64.iso.sha256.sig"
#   }
#
# size is the ISO's, in bytes, the size the bucket said it has. sha256Url
# is the checksum file, and sigUrl the checksum's signature, or null when
# the ISO went out without one. All three addresses start with ISO_URL, so
# they follow it when it moves to another address.
#
# Before <channel>.json moves, the checksum is fetched from ISO_URL the
# way a browser would, and has to come back as it went up. So ISO_URL
# pointed at an address that doesn't serve the bucket yet (a custom domain
# that isn't set up, say) stops the publish, and no link that goes
# nowhere gets written.
#
#   names <channel> <iso.sha256> <dir>
#       Checks the checksum file a build left beside its ISO
#       (origaitv-1.0.0-x86_64.iso.sha256) and writes it into <dir>. Needs no
#       keys. That file is what gets signed, before the upload.
#   upload <channel> <iso> <dir>
#       Checks the ISO against <dir>'s checksum, uploads the ISO and what's
#       in <dir>, asks the bucket for each file's size and compares, fetches
#       the checksum back from ISO_URL, the address people download from,
#       and then moves <channel>.json to the new ISO.
#       The ISO <channel>.json points at is never replaced: the same ISO
#       again keeps its bytes and only gets its checksum and signature
#       again, and a different ISO under that name is refused.
#       A channel only moves forward: an ISO older than the one
#       <channel>.json points at is refused, unless ORIGAITV_ISO_GO_BACK=1
#       says going back is meant. And a <channel>.json that's there but
#       doesn't name one of the channel's ISOs stops the upload. An ISO
#       under the name from before the rename to OrigaiTV counts as the
#       channel's ISO here: it's the one this replaces.
#   stale <channel>
#       Prints what clean would remove, one key a line, and removes nothing.
#   clean <channel>
#       Removes those, one at a time, each by its exact key.
#
# stale and clean take out the ISOs a channel had before, with their
# checksums and signatures. They only ever name a key that is right under
# iso/, carries that channel's kind of version (or is one of the channel's
# files from when they were called origaitv-<channel>.iso), and isn't the ISO
# <channel>.json points at. That covers the channel's ISO from before the
# rename, which carries the same version under the old name. Another
# channel's files and anything else in the bucket stay.
#
# Nothing is removed unless the listing is whole. The bucket has to say the
# listing isn't cut short, and the listing has to show what is known to be
# there: <channel>.json, read straight from the bucket by its key, and the
# ISO and checksum it names. More than ORIGAITV_ISO_STALE_MAX (20) keys to
# remove stops it too.
#
# R2 speaks S3, so the AWS CLI on GitHub's runners does the work. The bucket
# and its keys come from the environment, which CI fills from the repo's
# secrets and variables. None of them is in the repo.
#
# An ISO goes up in 64 MiB parts, four at a time, so a 6.7 GB ISO is about
# a hundred parts instead of eight hundred. R2 wants every part but the
# last to be the same size, and the CLI's classic uploader does that. A file
# that fails to upload is tried again, three tries in all
# (ORIGAITV_ISO_TRIES), with a wait between them that grows by
# ORIGAITV_ISO_RETRY_WAIT (30) seconds each time. After a failed try, any
# upload of that key the bucket still has open is aborted, so its parts
# don't sit there. Trying again is safe: an ISO isn't live until
# <channel>.json names it, and that only moves once every file is up. The
# log gets the CLI's version and every part it had to retry, with the
# reply it got, and nothing else from its debug output.

set -euo pipefail

usage() {
  echo "usage: origaitv-iso-publish names <channel> <iso.sha256> <dir> | upload <channel> <iso> <dir> | stale <channel> | clean <channel>" >&2
  exit 2
}

CHANNELS=(edge stable rc)
PREFIX=iso/

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

channel_ok() {
  local channel
  for channel in "${CHANNELS[@]}"; do
    [[ $1 == "$channel" ]] && return 0
  done
  echo "origaitv-iso-publish: the channel is edge, stable or rc, not '$1'" >&2
  return 1
}

# The versions a channel's ISOs carry, as a pattern. No two channels share
# one, so a file's name says whose it is.
channel_versions() {
  case $1 in
    stable) echo '[0-9]+\.[0-9]+\.[0-9]+' ;;
    rc) echo '[0-9]+\.[0-9]+\.[0-9]+-rc[0-9]+' ;;
    edge) echo '([0-9]+\.[0-9]+\.[0-9]+\.r[0-9]+\.g[0-9a-f]{7,40}|edge-([0-9]{4}\.[0-9]{2}\.[0-9]{2}-)?[0-9a-f]{7})' ;;
  esac
}

# Is $2 the file name of one of channel $1's ISOs?
channel_iso() {
  [[ $2 =~ ^origaitv-$(channel_versions "$1")-x86_64\.iso$ ]]
}

# The ISOs published before the rename to OrigaiTV went by the old name,
# with the same versions. The bucket's channel files still named them when
# the rename landed, so the first publish of each channel after it has to
# replace one. Such an ISO is only ever the one a channel had before: it's
# replaced and then taken out like any other, and nothing new goes up
# under that name. Once every channel's file names an origaitv- ISO, this
# has nothing left to match.
OLD_PREFIX=agentv-

# Is $2 the file name of one of channel $1's ISOs from before the rename?
channel_old_iso() {
  [[ $2 =~ ^$OLD_PREFIX$(channel_versions "$1")-x86_64\.iso$ ]]
}

r2() {
  : "${R2_ACCOUNT_ID:?set R2_ACCOUNT_ID to the ID of the Cloudflare account}"
  : "${R2_ACCESS_KEY_ID:?set R2_ACCESS_KEY_ID to the access key of the R2 token}"
  : "${R2_SECRET_ACCESS_KEY:?set R2_SECRET_ACCESS_KEY to the secret of the R2 token}"
  : "${R2_BUCKET:?set R2_BUCKET to the name of the bucket}"
  export AWS_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY AWS_DEFAULT_REGION=auto
  # R2 doesn't take the checksums newer AWS CLIs add to every upload.
  export AWS_REQUEST_CHECKSUM_CALCULATION=when_required AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
  # The CLI's own defaults are 8 MiB parts, ten at a time: about 800 parts
  # for an ISO. On 2026-11-13 three uploads in a row ended with a part R2
  # couldn't find, all with the AWS CLI 2.40.0 the runners had just got,
  # which retries a failed part much sooner than 2.39 did. Bigger parts and
  # fewer at a time mean far fewer requests, and fewer of them retried.
  # This file is the only config the CLI reads here, so nothing on the
  # runner changes it.
  export AWS_CONFIG_FILE=$WORK/aws-config
  cat >"$AWS_CONFIG_FILE" <<'EOF'
[default]
s3 =
  preferred_transfer_client = classic
  multipart_threshold = 64MB
  multipart_chunksize = 64MB
  max_concurrent_requests = 4
EOF
  endpoint="https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com"
}

# Aborts every upload of key $1 the bucket still has open, after a failed
# try. Only that exact key: no other file's upload is touched. Not being
# able to is a warning, not a stop. R2 drops an open upload by itself after
# seven days.
abort_open() {
  local key=$1 listing id parts
  local -a ids
  if ! listing=$(aws s3api list-multipart-uploads --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --prefix "$key" --output json); then
    echo "origaitv-iso-publish: couldn't list the open uploads of $key, so any it left stay until R2 drops them" >&2
    return 0
  fi
  mapfile -t ids < <(jq -r --arg key "$key" '(.Uploads // [])[] | select(.Key == $key) | .UploadId | strings' <<<"$listing" 2>/dev/null)
  for id in "${ids[@]}"; do
    [[ -n $id ]] || continue
    # How far it got, for whoever reads the log.
    parts=$(aws s3api list-parts --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$key" --upload-id "$id" --output json 2>/dev/null |
      jq '(.Parts // []) | length' 2>/dev/null || true)
    parts=${parts:-an unknown number of}
    if aws s3api abort-multipart-upload --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$key" --upload-id "$id" >&2; then
      echo "Aborted the open upload of $key (parts in the bucket: $parts)." >&2
    else
      echo "origaitv-iso-publish: couldn't abort the open upload of $key, so it stays until R2 drops it" >&2
    fi
  done
}

# The CLI's debug log, cut down to what says why a part went wrong: the
# CLI's version, each retry and its wait, a request that got no answer,
# and a reply of 4xx or 5xx (that line names the part). Nothing else of it
# is kept, so no request, header or signature reaches the log. A clean
# upload prints one line here, the version.
retries_only() {
  grep -E --line-buffered \
    -e ' - awscli\.clidriver - DEBUG - CLI version' \
    -e ' - botocore\.retries\.[a-z]+ - DEBUG - (Retry needed|Max attempts)' \
    -e ' - botocore\.endpoint - DEBUG - (Exception received|Response received to retry)' \
    -e ' - urllib3\.connectionpool - DEBUG - .*" [45][0-9]{2} ' \
    -e '^(upload failed|fatal error|An error occurred|aws: |warning: )' || true
}

# Uploads file $1 as key $2 under iso/. A failed try aborts what it left
# open, waits, and goes again, up to ORIGAITV_ISO_TRIES (3) tries in all.
put() {
  local from=$1 key=$PREFIX$2 try=1 tries=${ORIGAITV_ISO_TRIES:-3} wait=${ORIGAITV_ISO_RETRY_WAIT:-30}
  [[ $tries =~ ^[1-9][0-9]*$ ]] || { echo "origaitv-iso-publish: ORIGAITV_ISO_TRIES is a number above 0" >&2; exit 1; }
  [[ $wait =~ ^[0-9]+$ ]] || { echo "origaitv-iso-publish: ORIGAITV_ISO_RETRY_WAIT is a number of seconds" >&2; exit 1; }
  until aws s3 cp --debug --endpoint-url "$endpoint" --only-show-errors "$from" "s3://$R2_BUCKET/$key" 2> >(retries_only >&2) >&2; do
    abort_open "$key"
    if (( try >= tries )); then
      echo "origaitv-iso-publish: $key didn't upload in $tries tries, so nothing moves" >&2
      exit 1
    fi
    echo "origaitv-iso-publish: $key didn't upload on try $try of $tries. Trying again in $((wait * try)) seconds." >&2
    sleep $((wait * try))
    try=$((try + 1))
  done
  (( try == 1 )) || echo "$key went up on try $try." >&2
}

# Is version $1 older than $2? Versions sort the way sort -V sorts them:
# 0.2.0 before 1.0.0, 1.0.0-rc2 before 1.0.0-rc10, 0.2.0.r532.g... before
# 0.2.0.r540.g... and that before 1.0.0.r0.g... An edge build named by its
# day and commit has no version to compare, so it's never called older.
older() {
  [[ $1 != "$2" && $1 != edge-* && $2 != edge-* ]] || return 1
  [[ $(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1) == "$1" ]]
}

# Reads one ISO's checksum file into the caller's $hash and $file, or stops.
read_sum() {
  local sum=$1
  [[ -f $sum ]] || { echo "origaitv-iso-publish: no checksum file at $sum" >&2; exit 1; }
  # One line, "<sha256>  <name>.iso", as sha256sum writes it.
  [[ $(wc -l <"$sum") == 1 ]] || { echo "origaitv-iso-publish: $sum isn't one ISO's checksum" >&2; exit 1; }
  read -r hash file <"$sum"
  file=${file#\*}
  if [[ ! $hash =~ ^[0-9a-f]{64}$ || ! $file =~ ^origaitv-[A-Za-z0-9.]+(-[A-Za-z0-9.]+)*-x86_64\.iso$ ]]; then
    echo "origaitv-iso-publish: $sum isn't an OrigaiTV ISO's checksum" >&2
    exit 1
  fi
}

names() {
  local channel=$1 sum=$2 dir=$3 hash file version
  channel_ok "$channel"
  read_sum "$sum"
  # origaitv-1.0.0-x86_64.iso is 1.0.0.
  version=${file#origaitv-}
  version=${version%-x86_64.iso}
  if ! channel_iso "$channel" "$file"; then
    echo "origaitv-iso-publish: $file isn't a $channel ISO. A stable version looks like 1.0.0, an rc's like 1.0.0-rc1 and edge's like 0.2.0.r422.g155320d30." >&2
    exit 1
  fi
  mkdir -p "$dir"
  printf '%s  %s\n' "$hash" "$file" >"$dir/$file.sha256"
  # A signature left from an earlier run isn't this checksum's.
  if [[ -e $dir/$file.sha256.sig ]]; then
    unlink "$dir/$file.sha256.sig"
  fi
  echo "$file is the $channel ISO, version $version, sha256 $hash"
}

# Stops unless the bucket's copy of $2 is as big as the file at $1.
same_size() {
  local size served
  size=$(stat -c %s "$1")
  served=$(aws s3api head-object --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$PREFIX$2" \
    --query ContentLength --output text)
  if [[ $served != "$size" ]]; then
    echo "origaitv-iso-publish: the bucket's $PREFIX$2 is $served bytes, expected $size" >&2
    exit 1
  fi
}

# Is the checksum's signature in the bucket under $1? Prints true or false.
# Not being able to tell stops the publish: the channel's file would
# otherwise say there's no signature when there is one.
signed_in_bucket() {
  if aws s3api head-object --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$PREFIX$1" \
    >/dev/null 2>"$WORK/sig.err"; then
    echo true
  elif grep -qE 'NoSuchKey|\(404\)|Not Found' "$WORK/sig.err"; then
    echo false
  else
    cat "$WORK/sig.err" >&2
    echo "origaitv-iso-publish: couldn't tell whether $PREFIX$1 is in the bucket, so $PREFIX$channel.json stays where it was" >&2
    exit 1
  fi
}

# Stops unless ISO_URL serves the file at $1 under key $2, byte for byte.
# The checksum is a few bytes, so this asks for little. The query string
# keeps a cache in front of the bucket from answering with an older copy.
served_publicly() {
  local url="${ISO_URL%/}/$PREFIX$2"
  if ! curl -fsSL --retry 3 --retry-delay 5 --max-time 60 -o "$WORK/public" "$url?publish=$$" 2>"$WORK/public.err"; then
    cat "$WORK/public.err" >&2
    echo "origaitv-iso-publish: $url doesn't answer, so ISO_URL ($ISO_URL) isn't where people can download from yet, and $PREFIX$channel.json stays where it was" >&2
    exit 1
  fi
  if ! cmp -s "$1" "$WORK/public"; then
    echo "origaitv-iso-publish: $url isn't the file that was just uploaded, so ISO_URL ($ISO_URL) isn't this bucket's address, and $PREFIX$channel.json stays where it was" >&2
    exit 1
  fi
}

upload() {
  local channel=$1 iso=$2 dir=$3 hash file version item live live_file live_version size signed sig
  local -a sums files
  channel_ok "$channel"
  : "${ISO_URL:?set ISO_URL to the public address of the bucket}"
  r2
  # <dir> has one checksum file, the one names wrote. It says what the ISO
  # is called.
  sums=("$dir"/origaitv-*-x86_64.iso.sha256)
  if (( ${#sums[@]} != 1 )) || [[ ! -s ${sums[0]} ]]; then
    echo "origaitv-iso-publish: need one ISO's checksum file in $dir" >&2
    exit 1
  fi
  read_sum "${sums[0]}"
  if [[ ${sums[0]##*/} != "$file.sha256" ]] || ! channel_iso "$channel" "$file"; then
    echo "origaitv-iso-publish: ${sums[0]} isn't a $channel ISO's checksum" >&2
    exit 1
  fi
  [[ -s $iso ]] || { echo "origaitv-iso-publish: need $iso" >&2; exit 1; }
  # Check the ISO by its hash before anything leaves.
  if [[ $(sha256sum "$iso" | cut -d' ' -f1) != "$hash" ]]; then
    echo "origaitv-iso-publish: $iso isn't the ISO $dir/$file.sha256 is the checksum of" >&2
    exit 1
  fi
  version=${file#origaitv-}
  version=${version%-x86_64.iso}

  # Is this the ISO people are downloading right now? Then its bytes stay
  # as they are: a download under way, and the checksum people have, both
  # count on them. The same ISO again only gets what describes it (a
  # signature it went out without, say). Other bytes under the live name
  # are refused.
  live=""
  if aws s3api get-object --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$PREFIX$channel.json" "$WORK/live.json" \
    >/dev/null 2>"$WORK/live.err"; then
    # The file is there, so it has to say which ISO the channel is on. One
    # that can't be read that way isn't "nothing published yet": it's not
    # knowing what people download, and stale stops on it too.
    live_file=$(jq -r 'if type == "object" and (.file | type) == "string" then .file else "" end' "$WORK/live.json" 2>/dev/null || true)
    if ! channel_iso "$channel" "$live_file" && ! channel_old_iso "$channel" "$live_file"; then
      echo "origaitv-iso-publish: the bucket's $PREFIX$channel.json doesn't name a $channel ISO, so it isn't known which ISO people download now, and nothing is uploaded. Look at the bucket first." >&2
      exit 1
    fi
    if [[ $live_file == "$file" ]]; then
      live=$(jq -r '.sha256 | strings' "$WORK/live.json")
      if [[ $live != "$hash" ]]; then
        echo "origaitv-iso-publish: $file is the $channel ISO people download now, with sha256 ${live:-(none)}, and this one's is $hash. A published ISO isn't replaced under the same name, so nothing is uploaded. Publish this one as a new version." >&2
        exit 1
      fi
    else
      # A channel only moves forward. An older release's run started again
      # would otherwise put the channel back on it, and the cleanup would
      # then remove the newer ISO. Going back on purpose is a run by hand
      # that says so (ORIGAITV_ISO_GO_BACK=1).
      live_version=${live_file#origaitv-}
      live_version=${live_version#"$OLD_PREFIX"}
      live_version=${live_version%-x86_64.iso}
      if older "$version" "$live_version" && [[ ${ORIGAITV_ISO_GO_BACK:-} != "1" ]]; then
        echo "origaitv-iso-publish: the $channel ISO people download now is $live_version, and $version is older, so nothing is uploaded. A channel only moves forward. To go back on purpose, run the publish by hand and say so." >&2
        exit 1
      fi
    fi
  elif ! grep -qE 'NoSuchKey|\(404\)' "$WORK/live.err"; then
    # No file yet is a first publish. Anything else, and it isn't known
    # which ISO is live.
    cat "$WORK/live.err" >&2
    echo "origaitv-iso-publish: couldn't read the bucket's $PREFIX$channel.json, so nothing is uploaded" >&2
    exit 1
  fi

  # The ISO first, then what describes it. With no signature this time, one
  # an earlier publish left under this name goes: it isn't this checksum's.
  files=("$iso:$file" "$dir/$file.sha256:$file.sha256")
  if [[ -s $dir/$file.sha256.sig ]]; then
    files+=("$dir/$file.sha256.sig:$file.sha256.sig")
  fi
  for item in "${files[@]}"; do
    # The live ISO is in the bucket already, whole. The size check below
    # stops the publish if it isn't.
    if [[ -n $live && ${item##*:} == "$file" ]]; then
      echo "$file is the $channel ISO already, with the same sha256, so it isn't uploaded again." >&2
      continue
    fi
    put "${item%%:*}" "${item##*:}"
  done
  # The live ISO's signature is this checksum's too, so it stays.
  if [[ ! -s $dir/$file.sha256.sig && -z $live ]]; then
    aws s3api delete-object --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$PREFIX$file.sha256.sig" >&2
  fi

  # What the bucket has now, by size.
  for item in "${files[@]}"; do
    same_size "${item%%:*}" "${item##*:}"
  done
  size=$(stat -c %s "$iso")
  # And what people get from the address the channel's file will name.
  served_publicly "$dir/$file.sha256" "$file.sha256"

  # Whether the checksum is signed. With a signature this time, it is. The
  # same ISO again without one keeps the signature it went out with, if it
  # had one, so the bucket is asked.
  if [[ -s $dir/$file.sha256.sig ]]; then
    signed=true
  elif [[ -n $live ]]; then
    signed=$(signed_in_bucket "$file.sha256.sig")
  else
    signed=false
  fi
  sig=null
  if [[ $signed == true ]]; then
    sig=$(jq -n --arg url "${ISO_URL%/}/$PREFIX$file.sha256.sig" '$url')
  fi

  # The link that doesn't change, last of all. Everything above is in the
  # bucket at its full size by now. A publish that failed before this line
  # leaves <channel>.json on the ISO before.
  jq -n --arg channel "$channel" --arg version "$version" --arg file "$file" --argjson size "$size" \
    --arg sha256 "$hash" --arg url "${ISO_URL%/}/$PREFIX$file" --arg sums "${ISO_URL%/}/$PREFIX$file.sha256" \
    --argjson sig "$sig" \
    '{channel: $channel, version: $version, file: $file, size: $size, sha256: $sha256, url: $url,
      sha256Url: $sums, sigUrl: $sig}' >"$WORK/$channel.json"
  put "$WORK/$channel.json" "$channel.json"
  same_size "$WORK/$channel.json" "$channel.json"

  echo "${ISO_URL%/}/$PREFIX$file"
}

# Prints the keys of the ISOs channel $1 had before, one a line. Fails,
# printing none, when the listing can't be trusted or too many would go.
stale() {
  local channel=$1 max=${ORIGAITV_ISO_STALE_MAX:-20} listing key name current need
  local -a keys gone=()
  channel_ok "$channel" || return 1
  r2
  [[ $max =~ ^[0-9]+$ ]] || { echo "origaitv-iso-publish: ORIGAITV_ISO_STALE_MAX is a number" >&2; return 1; }

  # Which ISO the channel is on, read by its exact key, not from a listing.
  if ! aws s3api get-object --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$PREFIX$channel.json" "$WORK/now.json" >/dev/null; then
    echo "origaitv-iso-publish: couldn't read the bucket's $PREFIX$channel.json, so nothing is removed. Publish a $channel ISO first." >&2
    return 1
  fi
  current=$(jq -r 'if type == "object" and (.file | type) == "string" then .file else "" end' "$WORK/now.json" 2>/dev/null || true)
  if ! channel_iso "$channel" "$current"; then
    echo "origaitv-iso-publish: the bucket's $PREFIX$channel.json doesn't name a $channel ISO, so nothing is removed" >&2
    return 1
  fi

  # One page, and the bucket's own word on whether there's more. iso/ holds
  # a dozen keys, so a listing that needs a second page isn't this folder
  # as it should be.
  if ! listing=$(aws s3api list-objects-v2 --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --prefix "$PREFIX" \
    --no-paginate --max-keys 1000 --query '{keys: Contents[].Key, truncated: IsTruncated, count: KeyCount}' --output json); then
    echo "origaitv-iso-publish: couldn't list the bucket's $PREFIX, so nothing is removed" >&2
    return 1
  fi
  if ! jq -e 'type == "object" and (.keys | type) == "array" and all(.keys[]; type == "string")' <<<"$listing" >/dev/null 2>&1; then
    echo "origaitv-iso-publish: the bucket's listing of $PREFIX isn't a list of keys, so nothing is removed" >&2
    return 1
  fi
  if ! jq -e '.truncated == false and (.count == null or .count == (.keys | length))' <<<"$listing" >/dev/null 2>&1; then
    echo "origaitv-iso-publish: the bucket's listing of $PREFIX is cut short, so nothing is removed" >&2
    return 1
  fi
  mapfile -t keys < <(jq -r '.keys[]' <<<"$listing")

  # A whole listing shows what is known to be there. One that doesn't is
  # the wrong bucket, the wrong folder or a listing gone wrong.
  for need in "$channel.json" "$current" "$current.sha256"; do
    if ! printf '%s\n' "${keys[@]}" | grep -qxF -- "$PREFIX$need"; then
      echo "origaitv-iso-publish: the listing of $PREFIX doesn't show $need, which is there. It isn't whole, so nothing is removed." >&2
      return 1
    fi
  done

  for key in "${keys[@]}"; do
    # Right under iso/, a plain name, and nothing else in the bucket.
    [[ $key =~ ^iso/[A-Za-z0-9._-]+$ ]] || continue
    name=${key#"$PREFIX"}
    # The version note the channel had under its old name.
    if [[ $name == "origaitv-$channel.version" ]]; then
      gone+=("$key")
      continue
    fi
    # An ISO, its checksum or the checksum's signature.
    [[ $name =~ ^(.+\.iso)(\.sha256(\.sig)?)?$ ]] || continue
    name=${BASH_REMATCH[1]}
    # Never the one the channel is on.
    [[ $name != "$current" ]] || continue
    # This channel's, by its version (under the name from before the
    # rename too) or by the channel's old name.
    if channel_iso "$channel" "$name" || channel_old_iso "$channel" "$name" || [[ $name == "origaitv-$channel.iso" ]]; then
      gone+=("$key")
    fi
  done

  if (( ${#gone[@]} > max )); then
    echo "origaitv-iso-publish: ${#gone[@]} keys would go, more than $max, so nothing is removed. Look at the bucket first:" >&2
    printf '  %s\n' "${gone[@]}" >&2
    return 1
  fi
  (( ${#gone[@]} == 0 )) || printf '%s\n' "${gone[@]}"
}

clean() {
  local channel=$1 list key
  local -a gone
  list=$(stale "$channel") || exit 1
  if [[ -z $list ]]; then
    echo "Nothing to remove: iso/ has one $channel ISO and what goes with it."
    return 0
  fi
  r2
  mapfile -t gone <<<"$list"
  for key in "${gone[@]}"; do
    # Once more, right before it goes: under iso/, a plain name, no wildcard.
    [[ $key =~ ^iso/[A-Za-z0-9._-]+$ ]] || { echo "origaitv-iso-publish: won't remove '$key'" >&2; exit 1; }
    aws s3api delete-object --endpoint-url "$endpoint" --bucket "$R2_BUCKET" --key "$key" >/dev/null
    echo "Removed $key"
  done
}

case ${1:-} in
  names) (( $# == 4 )) || usage; names "$2" "$3" "$4" ;;
  upload) (( $# == 4 )) || usage; upload "$2" "$3" "$4" ;;
  stale)
    (( $# == 2 )) || usage
    list=$(stale "$2") || exit 1
    if [[ -z $list ]]; then
      echo "Nothing would be removed: iso/ has one $2 ISO and what goes with it."
    else
      echo "These would be removed:"
      while IFS= read -r key; do
        echo "  $key"
      done <<<"$list"
    fi
    ;;
  clean) (( $# == 2 )) || usage; clean "$2" ;;
  *) usage ;;
esac
